<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/special_title"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings">

    <!-- System Category -->
    <PreferenceCategory
        android:key="category_system"
        android:title="@string/category_system_title">

        <!-- Unlimited Google Photos -->
        <jp.project2by2.settings.preferences.SystemPropertySwitchPreference
            android:key="persist.sys.pixelprops.gphotos"
            android:title="@string/spoofing_photos_toggle_title"
            android:summary="@string/spoofing_photos_toggle_summary"
            android:defaultValue="true" />

        <!-- Force disable camera sound -->
        <jp.project2by2.settings.preferences.SystemPropertySwitchPreference
            android:key="persist.sys.camera.sound.disable"
            android:title="@string/disable_camera_sounds_toggle_title"
            android:summary="@string/disable_camera_sounds_toggle_summary"
            android:defaultValue="false" />

    </PreferenceCategory>
</PreferenceScreen>
